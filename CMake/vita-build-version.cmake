file(READ "${SOURCE_DIR}/CMakeLists.txt" root_cmake)
string(REGEX MATCH "project\\(2s2h VERSION ([0-9]+)\\.([0-9]+)\\.([0-9]+)" version_match "${root_cmake}")
if(NOT version_match)
    message(FATAL_ERROR "Cannot find the 2s2h project version")
endif()
set(CMAKE_PROJECT_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(CMAKE_PROJECT_VERSION_MINOR "${CMAKE_MATCH_2}")
set(CMAKE_PROJECT_VERSION_PATCH "${CMAKE_MATCH_3}")
foreach(variable PROJECT_BUILD_NAME PROJECT_TEAM)
    string(REGEX MATCH "set\\(${variable} \"([^\"]*)\"" value_match "${root_cmake}")
    if(NOT value_match)
        message(FATAL_ERROR "Cannot find ${variable}")
    endif()
    set(${variable} "${CMAKE_MATCH_1}")
endforeach()
configure_file("${SOURCE_DIR}/mm/src/boot/build.c.in" "${OUTPUT}" @ONLY)
